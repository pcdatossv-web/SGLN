<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Respaldo del PRIMER arranque. Los parámetros no secretos pueden
         compartirse en HKLM; las contraseñas se guardan únicamente en HKCU,
         cifradas con DPAPI CurrentUser, y cada usuario Windows las configura
         desde el formulario
         "Configurar servidor de base de datos" del login: no hace falta editar
         este XML en cada PC cliente.
         Para el servidor real use el nombre o la IP del equipo con MySQL
         (ej. Server=192.168.1.10) y el puerto 3306.
         La cuenta sgln_app recibe permisos DML por tabla mediante
         Privilegios_Minimos.sql; no puede alterar el esquema ni modificar
         la bitácora. La conexión exige TLS y CA PEM: VerifyCA valida la CA;
         VerifyFull valida además el nombre DNS/IP del servidor. -->
    <add name="SGLN"
         connectionString="Server=localhost;Port=3306;Database=sgln_sv;Uid=sgln_app;Pwd=;SslMode=VerifyCA;SslCa=;CharSet=utf8mb4;Connection Timeout=15"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="NombreAplicacion" value="SGLN El Salvador" />
    <!-- Valores de respaldo usados como respaldo si no hay configuración en el
         registro. En operación normal se guardan cifrados desde el formulario
         Configurar servidor de base de datos. -->
    <add key="Respaldos_Usuario" value="sgln_backup" />
    <add key="Respaldos_Clave" value="" />
    <!-- Opcional: ruta completa de mysqldump.exe. Si se deja vacía, el sistema
         la busca en PATH y en las carpetas típicas de MySQL/XAMPP. -->
    <add key="Respaldos_RutaMySQLDump" value="" />
  </appSettings>
</configuration>
