<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Base AISLADA de pruebas. Nunca apunte a sgln_sv. -->
    <add name="SGLN"
         connectionString="Server=localhost;Port=3306;Database=sgln_sv_pruebas;Uid=sgln_test_app;Pwd=;SslMode=Preferred;CharSet=utf8mb4;Connection Timeout=30"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="NombreAplicacion" value="SGLN El Salvador - Pruebas" />
    <!-- Aislamiento obligatorio: el arnés nunca lee ni escribe la configuración
         del registro de Windows; siempre usa la cadena de sgln_sv_pruebas. -->
    <add key="Conexion_IgnorarRegistro" value="True" />
    <!-- Cuenta temporal de solo lectura con SHOW VIEW y TRIGGER para mysqldump.
         El ejecutor asigna una contraseña aleatoria en cada corrida. -->
    <add key="Respaldos_Usuario" value="sgln_test_backup" />
    <add key="Respaldos_Clave" value="" />
    <!-- Se completa en Ejecutar-Pruebas.ps1 con el mysqldump.exe detectado. -->
    <add key="Respaldos_RutaMySQLDump" value="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe" />
  </appSettings>
</configuration>
