<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Base AISLADA de pruebas. Nunca apunte a sgln_sv. -->
    <add name="SGLN"
         connectionString="Server=localhost;Port=3306;Database=sgln_sv_pruebas;Uid=sgln_app;Pwd=Abog@dos26;SslMode=Preferred;AllowPublicKeyRetrieval=True;CharSet=utf8mb4;Connection Timeout=30"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="NombreAplicacion" value="SGLN El Salvador - Pruebas" />
    <!-- Aislamiento obligatorio: el arnés nunca lee ni escribe la configuración
         del registro de Windows; siempre usa la cadena de sgln_sv_pruebas. -->
    <add key="Conexion_IgnorarRegistro" value="True" />
    <!-- Usuario con SELECT, LOCK TABLES, SHOW VIEW, EVENT y TRIGGER sobre
         la base de pruebas, necesario para mysqldump. -->
    <add key="Respaldos_Usuario" value="sgln_backup" />
    <add key="Respaldos_Clave" value="Abog@dos26" />
    <!-- Se completa en Ejecutar-Pruebas.ps1 con el mysqldump.exe detectado. -->
    <add key="Respaldos_RutaMySQLDump" value="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe" />
  </appSettings>
</configuration>
